{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "x86-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cmake/x86-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IV50_TARGET_ARCH": "x86",
        "IV50_FFMPEG_ROOT": "${sourceDir}/build/ffmpeg/x86/install"
      }
    },
    {
      "name": "x64-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cmake/x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IV50_TARGET_ARCH": "x64",
        "IV50_FFMPEG_ROOT": "${sourceDir}/build/ffmpeg/x64/install"
      }
    },
    {
      "name": "x86-debug",
      "inherits": "x86-release",
      "binaryDir": "${sourceDir}/build/cmake/x86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-debug",
      "inherits": "x64-release",
      "binaryDir": "${sourceDir}/build/cmake/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "x86-release", "configurePreset": "x86-release" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "x86-debug", "configurePreset": "x86-debug" },
    { "name": "x64-debug", "configurePreset": "x64-debug" }
  ],
  "testPresets": [
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
